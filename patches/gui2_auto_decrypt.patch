+// The remembered decryption password, kept in the TWRP folder on the persist
+// partition so a later boot can unlock without asking. The file is lightly
+// obfuscated to keep it out of casual view; anyone who can read the persist
+// partition can still recover the password, so treat the device as unlocked
+// for anyone with physical or root access.
+std::string load_saved_crypto_password();
+void store_saved_crypto_password(const std::string& password);
+void clear_saved_crypto_password();
+
 }  // namespace gui2_backend
 
