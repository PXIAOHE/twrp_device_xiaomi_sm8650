+// --- temporary startup diagnostic probe (manet hang investigation) ---
+// Appends one line to ramfs, to persist (survives a reboot) and to the
+// kernel log. Remove after the investigation.
+#include <stdio.h>
+#include <time.h>
+static inline void twrp_diag_write(const char* line) {
+  FILE* f = fopen("/tmp/twrp_diag.log", "a");
+  if (f) { fputs(line, f); fputc('\n', f); fclose(f); }
+  FILE* p = fopen("/mnt/vendor/persist/twrp_diag.log", "a");
+  if (p) { fputs(line, p); fputc('\n', p); fclose(p); }
+  FILE* k = fopen("/dev/kmsg", "w");
+  if (k) { fprintf(k, "TWRP-DIAG: %s\n", line); fclose(k); }
+}
+static inline void twrp_diag_log(const char* tag) {
+  char buf[128];
+  snprintf(buf, sizeof(buf), "[%ld] %s", (long)time(0), tag);
+  twrp_diag_write(buf);
+}
+static inline void twrp_diag_step(int step) {
+  char buf[128];
+  snprintf(buf, sizeof(buf), "[%ld] step=%d", (long)time(0), step);
+  twrp_diag_write(buf);
+}
+// --- end diagnostic probe ---
+
 #endif  // _VARIABLES_HEADER_
